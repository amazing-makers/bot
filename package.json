{
  "name": "amakers-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Amakers multi-bot platform: marketing, design, mockup bots + admin + reseller",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=@amakers/admin",
    "dev:marketing": "npm run dev --workspace=@amakers/marketing",
    "dev:pdp": "npm run dev --workspace=@amakers/pdp",
    "dev:design": "npm run dev --workspace=@amakers/design",
    "dev:mockup": "npm run dev --workspace=@amakers/mockup",
    "dev:insta-auto": "npm run dev --workspace=@amakers/insta-auto",
    "dev:blog-auto": "npm run dev --workspace=@amakers/blog-auto",
    "dev:tistory-auto": "npm run dev --workspace=@amakers/tistory-auto",
    "build": "npm run build --workspaces --if-present",
    "build:admin": "npm run build --workspace=@amakers/admin",
    "build:marketing": "npm run build --workspace=@amakers/marketing",
    "build:pdp": "npm run build --workspace=@amakers/pdp",
    "build:design": "npm run build --workspace=@amakers/design",
    "build:mockup": "npm run build --workspace=@amakers/mockup",
    "build:insta-auto": "npm run build --workspace=@amakers/insta-auto",
    "build:blog-auto": "npm run build --workspace=@amakers/blog-auto",
    "build:tistory-auto": "npm run build --workspace=@amakers/tistory-auto",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run generate --workspace=@amakers/db",
    "db:migrate": "npm run migrate --workspace=@amakers/db",
    "db:studio": "npm run studio --workspace=@amakers/db"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
