# instabot 환경변수 템플릿
# 이 파일을 .env.local 로 복사한 뒤 각 값을 채우세요. (.env.local 은 커밋 X)

# === 필수: DB (다른 봇과 같은 Supabase) ===
DATABASE_URL=postgresql://postgres.xxx:password@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# === 필수: NextAuth (SSO) ===
# 마케팅봇과 똑같은 값 사용해야 SSO 자동 동작.
NEXTAUTH_SECRET=<마케팅봇과 같은 32+ chars>
NEXTAUTH_URL=http://localhost:3500

# === 필수: 토큰 암호화 (AES-256-GCM) ===
# 인스타 Page Access Token 암호화용. 64글자 hex (32 bytes).
# 생성: bash `openssl rand -hex 32`
#       PowerShell `[Convert]::ToHexString((1..32 | %{[byte](Get-Random -Maximum 256)}))`
# ⚠️ 재생성하면 기존 저장된 토큰 모두 복호화 불가 — 운영 시 고정.
ENCRYPTION_KEY=<64글자 hex>

# === 선택: AI (Phase 3 캡션/이미지) ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# === 선택: Facebook OAuth 1-click (Phase 2) ===
META_APP_ID=
META_APP_SECRET=

# === 선택 ===
NODE_ENV=development
