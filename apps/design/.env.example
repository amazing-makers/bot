# designbot 환경변수 템플릿
# 이 파일을 .env.local 로 복사한 뒤 각 값을 채우세요.

# === 필수: DB === (pdpbot/마케팅봇과 같은 Supabase)
DATABASE_URL=postgresql://postgres.xxx:password@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# === 필수: NextAuth (SSO) === — 다른 봇과 똑같은 값
NEXTAUTH_SECRET=<32+ chars hex>
NEXTAUTH_URL=http://localhost:3300

# === 필수: BYOK 키 암호화 === — pdpbot 의 ENCRYPTION_SECRET 와 같은 값 권장 (사용자가 한 번 입력한 BYOK 키 공유)
API_KEY_ENCRYPTION_SECRET=<64 chars hex>

# === 필수: AI API 키 === (Phase 2 에서 활성화 — 지금은 빈 채로 OK)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=

# === 필수: R2 storage === (썸네일 + 업로드 이미지)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=amakers-design
R2_PUBLIC_URL=https://cdn.amakers.co.kr

NODE_ENV=development
