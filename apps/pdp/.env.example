# pdpbot 환경변수 템플릿
# 이 파일을 .env.local 로 복사한 뒤 각 값을 채우세요.
# .env.local 은 .gitignore 에 자동 포함 — 절대 commit X.

# === 필수: DB ===
# 마케팅봇 .env.local 에서 그대로 복사. 같은 Supabase 사용.
DATABASE_URL=postgresql://postgres.xxx:password@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# === 필수: NextAuth (SSO) ===
# 마케팅봇과 똑같은 값 사용해야 SSO 자동 동작.
NEXTAUTH_SECRET=<마케팅봇과 같은 32+ chars>
NEXTAUTH_URL=http://localhost:3200

# === 필수: BYOK 키 암호화 ===
# 사용자가 입력하는 OpenAI/Anthropic/Replicate 키를 AES-256-GCM 으로 암호화하기 위한 secret.
# 새 봇/환경마다 새로 생성 (재생성하면 기존 사용자 키 모두 무효화됨 — 운영 시 주의).
# 생성: PowerShell `[Convert]::ToHexString((1..32 | %{ Get-Random -Maximum 256 } | %{[byte]$_}))` 또는
#       bash `openssl rand -hex 32`
API_KEY_ENCRYPTION_SECRET=<openssl rand -hex 32 결과 64글자 hex>

# === 필수: AI API 키 ===
# OpenAI: https://platform.openai.com/api-keys → Create new secret key
OPENAI_API_KEY=sk-...
# Anthropic: https://console.anthropic.com/settings/keys → Create Key
ANTHROPIC_API_KEY=sk-ant-...
# Replicate: https://replicate.com/account/api-tokens → Create token
REPLICATE_API_TOKEN=r8_...

# === 필수: R2 storage ===
# 마케팅봇과 같은 bucket 사용 가능. 또는 'amakers-pdp' 새 bucket 생성.
# https://dash.cloudflare.com → R2 → Create bucket
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=amakers-pdp
# Custom domain 또는 r2.dev (개발용)
R2_PUBLIC_URL=https://cdn.amakers.co.kr

# === Stripe (결제, 운영자 1회 등록) ===
# 1. https://dashboard.stripe.com/ → Account → API keys → Secret key 복사
STRIPE_SECRET_KEY=sk_test_...
# 2. Developers → Webhooks → Add endpoint:
#    URL: https://pdpbot.amakers.co.kr/api/webhook/stripe
#    Events: checkout.session.completed
#    → 'Signing secret' 복사
STRIPE_WEBHOOK_SECRET=whsec_...

# === 선택: 옵션 ===
NODE_ENV=development
