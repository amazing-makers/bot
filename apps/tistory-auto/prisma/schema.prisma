// 티스토리오토 (tistoryauto) Prisma schema
//
// 전략: 다른 봇과 같은 DATABASE_URL → 같은 DB. 공유 테이블(User/UserCredit/CreditTransaction) 동일 정의.
//
// ⚠️ 티스토리는 공개 발행 API 가 사실상 막혀 있어 자동 발행은 데스크톱 에이전트(Phase 2) 필요.
//    이 스키마는 계정 등록 + 글 초안/예약 관리까지. 실제 발행은 에이전트가 처리.

generator client {
    provider = "prisma-client-js"
    output   = "../node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
}

// ===== 공유 모델 =====

enum UserRole {
    USER
    ADMIN
}

model User {
    id                    String    @id @default(cuid())
    email                 String    @unique
    password              String
    name                  String?
    role                  UserRole  @default(USER)
    onboardingCompletedAt DateTime?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    currentWorkspaceId String?

    tistoryAccounts   TistoryAccount[]
    tistoryPosts      TistoryPost[]
    tistoryAgentTokens TistoryAgentToken[]
    credits           UserCredit?

    @@map("User")
}

model UserCredit {
    id        String   @id @default(cuid())
    userId    String   @unique
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    balance   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    transactions CreditTransaction[]

    @@map("UserCredit")
}

model CreditTransaction {
    id           String     @id @default(cuid())
    userCreditId String
    userCredit   UserCredit @relation(fields: [userCreditId], references: [id], onDelete: Cascade)
    delta        Int
    balanceAfter Int
    bot          String? // 'tistoryauto' | 'instaauto' | 'marketingbot' 등
    action       String
    refType      String?
    refId        String?
    metadata     Json?
    createdAt    DateTime   @default(now())

    @@index([userCreditId, createdAt])
    @@index([bot, createdAt])
    @@map("CreditTransaction")
}

// ===== 티스토리오토 전용 모델 =====

enum TistoryAccountStatus {
    ACTIVE
    PENDING_AUTH // 에이전트 인증 대기
    ERROR
}

enum TistoryPostStatus {
    DRAFT
    SCHEDULED
    QUEUED // 에이전트 발행 대기 (큐 적재됨)
    PUBLISHING // 에이전트가 발행 진행 중
    PUBLISHED
    FAILED
}

// 등록된 티스토리 블로그.
//
// 티스토리는 공개 발행 API 가 없어 카카오 로그인 기반 데스크톱 에이전트(Phase 2)로 발행 예정.
// 현재는 블로그 주소 등록 + 글 관리까지.
model TistoryAccount {
    id       String @id @default(cuid())
    userId   String
    user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    /** 티스토리 블로그 주소 (예: myblog.tistory.com) */
    siteUrl  String
    /** 표시용 이름 (블로그 제목/별명) */
    username String
    /** (Phase2) 카카오 로그인 세션 등 자격증명 — AES-256-GCM. 현재 미사용(null). */
    encryptedSecret String?              @db.Text
    status          TistoryAccountStatus @default(ACTIVE)
    createdAt       DateTime             @default(now())
    updatedAt       DateTime             @updatedAt

    posts TistoryPost[]

    @@unique([userId, siteUrl])
    @@index([userId])
    @@map("TistoryAccount")
}

// 티스토리 글 (초안 → 예약 → 에이전트 발행).
model TistoryPost {
    id        String         @id @default(cuid())
    userId    String
    user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    accountId String
    account   TistoryAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

    title    String
    content  String  @db.Text
    photoUrl String?

    status      TistoryPostStatus @default(DRAFT)
    scheduledAt DateTime?
    publishedAt DateTime?

    remotePostId String?
    link         String?
    error        String? @db.Text
    creditsUsed  Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId, createdAt])
    @@index([accountId, status])
    @@index([status, scheduledAt])
    @@map("TistoryPost")
}

// 데스크톱 에이전트 인증 토큰 (poll/complete API Bearer).
// 사용자가 발급 → 에이전트 설정에 입력 → 에이전트가 이 토큰으로 큐를 폴링.
model TistoryAgentToken {
    id         String    @id @default(cuid())
    userId     String
    user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    /** 32바이트 hex 랜덤 토큰 (Bearer) */
    token      String    @unique
    label      String?
    lastUsedAt DateTime?
    createdAt  DateTime  @default(now())

    @@index([userId])
    @@map("TistoryAgentToken")
}
