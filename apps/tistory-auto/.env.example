# tistoryauto 환경변수 템플릿
# 이 파일을 .env.local 로 복사한 뒤 채우세요. (.env.local 은 커밋 X)

# === 필수: DB (다른 봇과 같은 Supabase) ===
DATABASE_URL=postgresql://postgres.xxx:password@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# === 필수: NextAuth (SSO) — 마케팅봇과 같은 값 ===
NEXTAUTH_SECRET=<마케팅봇과 같은 32+ chars>
NEXTAUTH_URL=http://localhost:3700

# === 필수: 자격증명 암호화 (AES-256-GCM) ===
# WordPress Application Password 암호화용. 64글자 hex.
# 생성: bash `openssl rand -hex 32`
ENCRYPTION_KEY=<64글자 hex>

# === 선택: AI (Phase 3 글쓰기) ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# === 선택 ===
NODE_ENV=development
