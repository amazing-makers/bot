# Database (marketingbot 과 같은 Supabase URL)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# NextAuth
NEXTAUTH_SECRET=long-random-string-here
NEXTAUTH_URL=http://localhost:3100
# 운영: NEXTAUTH_URL=https://adminbot.amakers.co.kr

# Admin 화이트리스트 (콤마 구분)
ADMIN_EMAILS=help@amakers.co.kr

# 임시 admin 비밀번호 (개발용 — 실제는 marketingbot bcrypt 통합 예정)
ADMIN_PASSWORD=change-me-in-production
