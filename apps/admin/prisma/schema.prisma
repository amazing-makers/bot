// Admin 앱 read-only 미러 스키마.
// 같은 Supabase DB 를 가리키되, admin 이 필요한 모델만 정의.
// marketingbot 의 schema 가 source-of-truth — 변경 시 동기화 필요.
//
// ⚠️ 마이그레이션 (prisma migrate dev) 절대 실행 금지! 읽기 전용 + 신규 모델만 추가.

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────────────────────────────────────
//  기존 marketingbot 모델 (read-only 미러 — 컬럼은 필요한 것만)
// ───────────────────────────────────────────────────────────

model User {
  id                    String    @id
  email                 String    @unique
  name                  String?
  role                  String    @default("USER")
  onboardingCompletedAt DateTime?
  createdAt             DateTime
  updatedAt             DateTime

  // 리셀러 추천 (다-1 에서 marketingbot 스키마에도 동일 필드 추가 예정)
  referredByCodeId String?
  referredByCode   ReferralCode? @relation("ReferredByCode", fields: [referredByCodeId], references: [id])
  reseller         Reseller?

  subscription Subscription?
  campaigns    Campaign[]
  series       CampaignSeries[]
  channels     MarketingChannel[]
  feedbacks    UserFeedback[]

  @@map("User")
}

model Subscription {
  id                   String    @id
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id])
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  plan                 String    @default("FREE")
  status               String    @default("active")
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime
  updatedAt            DateTime

  @@map("Subscription")
}

model Campaign {
  id        String          @id
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  name      String
  status    String
  createdAt DateTime
  updatedAt DateTime
  tasks     ScheduledTask[]

  @@map("Campaign")
}

model CampaignSeries {
  id             String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  name           String
  status         String
  totalPosts     Int
  completedPosts Int      @default(0)
  createdAt      DateTime
  updatedAt      DateTime

  @@map("CampaignSeries")
}

model MarketingChannel {
  id          String          @id
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  type        String
  accountName String
  status      String
  region      String?
  language    String?
  createdAt   DateTime
  tasks       ScheduledTask[]

  @@map("MarketingChannel")
}

// Phase 31 — 운영 현황 위젯용 미러 (read-only)
model ScheduledTask {
  id          String           @id
  campaignId  String
  campaign    Campaign         @relation(fields: [campaignId], references: [id])
  channelId   String
  channel     MarketingChannel @relation(fields: [channelId], references: [id])
  agentId     String?
  content     String
  status      String
  scheduledAt DateTime
  executedAt  DateTime?
  errorLog    String?
  createdAt   DateTime
  updatedAt   DateTime

  @@map("ScheduledTask")
  @@index([status])
  @@index([executedAt])
}

model AgentInstance {
  id         String   @id
  userId     String
  machineId  String   @unique
  name       String?
  version    String
  os         String?
  lastSeenAt DateTime
  createdAt  DateTime

  @@map("AgentInstance")
  @@index([lastSeenAt])
}

model License {
  id         String    @id
  userId     String
  key        String    @unique
  plan       String
  validUntil DateTime?
  createdAt  DateTime
  updatedAt  DateTime

  @@map("License")
  @@index([userId])
}

// ───────────────────────────────────────────────────────────
//  신규 모델 — admin / reseller 전용 (다-1)
// ───────────────────────────────────────────────────────────

model Reseller {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  name            String
  contactEmail    String
  taxStatus       String   @default("INDIVIDUAL")  // INDIVIDUAL | BUSINESS
  businessNumber  String?
  bankAccount     String?
  commissionRate  Float    @default(0.10)
  status          String   @default("ACTIVE")     // ACTIVE | SUSPENDED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  referralCodes ReferralCode[]
  commissions   ReferralCommission[]

  @@map("Reseller")
}

model ReferralCode {
  id          String   @id @default(cuid())
  code        String   @unique
  resellerId  String
  reseller    Reseller @relation(fields: [resellerId], references: [id])
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  referrals User[] @relation("ReferredByCode")

  @@index([resellerId])
  @@map("ReferralCode")
}

model ReferralCommission {
  id              String    @id @default(cuid())
  resellerId      String
  reseller        Reseller  @relation(fields: [resellerId], references: [id])
  referredUserId  String
  periodYearMonth String                                       // "2026-05"
  baseRevenue     Decimal   @db.Decimal(12, 2)
  commissionRate  Float
  amount          Decimal   @db.Decimal(12, 2)
  status          String    @default("PENDING")                // PENDING | PAID | CANCELLED
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime  @default(now())

  @@unique([resellerId, referredUserId, periodYearMonth])
  @@index([resellerId, status])
  @@map("ReferralCommission")
}

// Phase 25 미러 — 사용자 피드백 (admin read-only)
model UserFeedback {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  context   String?
  createdAt DateTime

  @@map("UserFeedback")
}

// Phase 31 — admin 액션 감사 로그 (admin 앱 전용 테이블, write 가능)
//
// admin 슈퍼유저의 모든 mutating 액션 기록:
//   - TRIAL_EXTEND, PLAN_OVERRIDE, USER_SUSPEND, USER_DELETE, RESELLER_CREATE/UPDATE,
//     COMMISSION_PAID, IMPERSONATE 등.
// 사용처: /audit 페이지 + GDPR 감사 + 보안 사고 추적.
model AdminAuditLog {
  id           String   @id @default(cuid())
  adminEmail   String   // 액션 수행한 admin 이메일
  action       String   // TRIAL_EXTEND, PLAN_OVERRIDE, etc.
  targetType   String?  // user | reseller | subscription | campaign
  targetId     String?  // 대상 레코드 id
  targetLabel  String?  // 사람이 읽기 위한 라벨 (예: 사용자 이메일, 리셀러 이름)
  metadata     Json?    // 추가 컨텍스트 (이전 값, 새 값, 사유 등)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([adminEmail])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("AdminAuditLog")
}
