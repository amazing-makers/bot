// 블로그봇 (blogauto) Prisma schema
//
// 전략: 다른 봇과 같은 DATABASE_URL → 같은 Supabase DB.
// 공유 테이블(User/UserCredit/CreditTransaction)은 동일 정의. 전용 테이블 prefix 없이 별도.
//
// ⚠️ 신규 테이블 추가는 공유 DB 마이그레이션 — 백업 후 `npx prisma db push` (사용자 액션, SETUP.md).

generator client {
    provider = "prisma-client-js"
    output   = "../node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
}

// ===== 공유 모델 =====

enum UserRole {
    USER
    ADMIN
}

model User {
    id                    String    @id @default(cuid())
    email                 String    @unique
    password              String
    name                  String?
    role                  UserRole  @default(USER)
    onboardingCompletedAt DateTime?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    currentWorkspaceId String?

    blogAccounts BlogAccount[]
    blogPosts    BlogPost[]
    credits      UserCredit?

    @@map("User")
}

model UserCredit {
    id        String   @id @default(cuid())
    userId    String   @unique
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    balance   Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    transactions CreditTransaction[]

    @@map("UserCredit")
}

model CreditTransaction {
    id           String     @id @default(cuid())
    userCreditId String
    userCredit   UserCredit @relation(fields: [userCreditId], references: [id], onDelete: Cascade)
    delta        Int
    balanceAfter Int
    bot          String? // 'blogauto' | 'instabot' | 'marketingbot' 등
    action       String
    refType      String?
    refId        String?
    metadata     Json?
    createdAt    DateTime   @default(now())

    @@index([userCreditId, createdAt])
    @@index([bot, createdAt])
    @@map("CreditTransaction")
}

// ===== 블로그봇 전용 모델 =====

// 블로그 플랫폼 종류. Phase 1 은 WordPress(HTTP REST) 만. 네이버블로그/티스토리는 별도 봇/Phase.
enum BlogProvider {
    WORDPRESS
    NAVER // Phase 2 — 데스크톱 에이전트(브라우저 자동화) 경유 예정
}

enum BlogAccountStatus {
    ACTIVE
    PENDING_AUTH
    ERROR
}

// 연결된 블로그 계정/사이트.
//
// WordPress: REST API + Application Password (HTTP only, 에이전트 불필요).
model BlogAccount {
    id       String       @id @default(cuid())
    userId   String
    user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    provider BlogProvider @default(WORDPRESS)
    /** 사이트 base URL (예: https://myblog.com) */
    siteUrl  String
    /** 계정 username (표시 + 인증) */
    username String
    /** WordPress Application Password — AES-256-GCM 암호화 (iv:ct:tag hex) */
    encryptedSecret String            @db.Text
    status          BlogAccountStatus @default(ACTIVE)
    createdAt       DateTime          @default(now())
    updatedAt       DateTime          @updatedAt

    posts BlogPost[]

    @@unique([userId, provider, siteUrl])
    @@index([userId])
    @@map("BlogAccount")
}

enum BlogPostStatus {
    DRAFT
    SCHEDULED
    PUBLISHING
    PUBLISHED
    FAILED
}

// 블로그 게시글.
model BlogPost {
    id        String      @id @default(cuid())
    userId    String
    user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    accountId String
    account   BlogAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

    title   String
    /** 본문 (HTML 또는 plain text — WP 가 wpautop 처리) */
    content String  @db.Text
    /** 대표 이미지 public URL (선택) */
    photoUrl String?

    status      BlogPostStatus @default(DRAFT)
    scheduledAt DateTime?
    publishedAt DateTime?

    /** 발행 성공 시 원격 글 ID */
    remotePostId String?
    /** 게시글 영구 링크 */
    link        String?
    error       String? @db.Text
    creditsUsed Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId, createdAt])
    @@index([accountId, status])
    @@index([status, scheduledAt])
    @@map("BlogPost")
}
